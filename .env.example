# Copy to .env.local. Keep credentials out of source control.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback
# WHOOP signs webhook requests with the client secret.
WHOOP_WEBHOOK_SECRET=
# A random 32-byte key encoded as base64.
TOKEN_ENCRYPTION_KEY_BASE64=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
# Public OAuth client, PKCE required. This ID is not a secret.
CLERK_MCP_CLIENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
