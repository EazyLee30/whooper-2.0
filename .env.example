# Whooper 2.0 — 环境变量占位符
# 按规格 §12：只通过部署平台 / 本地 .env.local 设置，绝不进仓库、聊天、日志。
# 复制为 .env.local 后填入真实值。

# Neon PostgreSQL（P0 必须）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# WHOOP Developer App（P0 必须）
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback
# Webhook 若平台单独提供则填，否则保持与 WHOOP_CLIENT_SECRET 一致（P1）
WHOOP_WEBHOOK_SECRET=

# Token 加密密钥：32 字节随机，base64 编码（P0 必须）
# 生成命令（在你自己电脑上跑，不要发给我）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_BASE64=

# Clerk — MCP OAuth 授权服务器（P0 必须）
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# 应用地址
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 定时对账任务口令（P1）
CRON_SECRET=
